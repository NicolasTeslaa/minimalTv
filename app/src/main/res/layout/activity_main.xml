<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="28dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Minimal TV" android:textColor="@color/text_primary"
                android:textSize="32sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Your apps. Nothing else." android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
        <TextView android:id="@+id/clock" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="18dp"
            android:textColor="@color/text_primary" android:textSize="22sp" />
        <ImageView android:id="@+id/topSettings" android:layout_width="52dp"
            android:layout_height="52dp" android:background="@drawable/action_button"
            android:contentDescription="Configurações" android:focusable="true"
            android:clickable="true" android:padding="12dp" android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:layout_marginBottom="12dp"
        android:text="Aplicativos" android:textColor="@color/text_primary"
        android:textSize="23sp" android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/appGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="true"
        android:descendantFocusability="afterDescendants"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/favoritesAction"
            android:layout_width="wrap_content" android:layout_height="52dp"
            android:background="@drawable/action_button" android:clickable="true"
            android:focusable="true" android:gravity="center"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:text="Gerenciar favoritos" android:textColor="@color/text_primary"
            android:textSize="16sp" />
        <TextView android:id="@+id/settingsAction"
            android:layout_width="wrap_content" android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/action_button" android:clickable="true"
            android:focusable="true" android:gravity="center"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:text="Configurações" android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
